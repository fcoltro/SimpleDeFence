<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleDeFence.UI.Themes">

    <!-- Row hover, strong enough to actually see.

         WinUI's stock ListViewItem hover is SubtleFillColorSecondary - around 6% white in dark.
         On a page whose rows already carry a classification tint (Connections colours by whether
         the traffic stayed local, Rules by whether the entry is a block) a 6% wash over that tint
         is indistinguishable from no wash at all, and the lists read as if hover were simply not
         implemented.

         Overriding the brushes rather than replacing the ListViewItem template on each page,
         because the Rules list is SelectionMode="Multiple" and its checkboxes are drawn by the
         stock ListViewItemPresenter - a custom ControlTemplate would silently delete them, and
         with them the only way to select anything for the Remove button.

         In ThemeDictionaries, unlike the status palette above: these are consumed by XAML
         {ThemeResource} lookups on the elements themselves, which resolve against the element's
         own ActualTheme, so the per-theme split works correctly here and is what gives a hover
         that reads on a near-white row and a near-black one alike. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="RowHoverBrush"                                 Color="#1A000000"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"             Color="#1A000000"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"     Color="#26000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="RowHoverBrush"                                 Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"             Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"     Color="#30FFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <!-- Left to the system: high contrast users have chosen their own highlight colour and
                 a hand-picked wash would override it with something they did not ask for. -->
            <SolidColorBrush x:Key="RowHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- One explicit status palette, shared by light and dark, instead of the WinUI system
         semantic colours these used to bind to.

         Those system colours are deliberately different per theme: the light variants are darkened
         hard for contrast against white (SystemFillColorSuccess is #6CCB5F in dark but #0F7B0F in
         light). That is the right call for text, but these roles are never text - they are the mode
         chip's accent bar - so the only visible effect was that the same firewall state looked like
         a different colour in each theme, light reading as muddy beside dark's vivid one.

         Mid-tone values rather than dark's brighter set copied across: dark's caution yellow
         (#FCE100) and critical pink (#FF99A4) all but vanish on a light card, so lifting light to
         match dark exactly would have traded one imbalance for a worse one. These carry the same
         hue in both themes and stay legible on a near-white card and a near-black one alike.

         Defined at the dictionary root, not in ThemeDictionaries, because ModeStateToBrushConverter
         resolves them with a flat Application.Current.Resources lookup - which consults the *app's*
         theme, not the element's RequestedTheme, and so could hand back the wrong theme's brush
         whenever the user picks a theme that differs from the OS. With one palette that mismatch
         cannot happen at all. The cost is that high-contrast modes now get these fixed colours
         rather than the user's system colours; acceptable here only because status is never
         signalled by colour alone - the chip always carries a glyph and a word as well. -->
    <SolidColorBrush x:Key="StatusSuccessBrush"     Color="#3DA45D"/>
    <SolidColorBrush x:Key="StatusCautionBrush"     Color="#E0A106"/>
    <SolidColorBrush x:Key="StatusInformationBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="StatusNeutralBrush"     Color="#9A9A9A"/>
    <SolidColorBrush x:Key="StatusAccentAltBrush"   Color="#4C9BE8"/>

    <local:ModeStateToBrushConverter x:Key="ModeStateToBrush"/>

    <!-- Row hover, strong enough to actually see.
         See the ThemeDictionaries below for the values and the reasoning. -->
</ResourceDictionary>
