<Window
    x:Class="SimpleDeFence.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="18" MaxWidth="560" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="SimpleDeFence" Style="{StaticResource TitleLargeTextBlockStyle}"/>
                <TextBlock x:Name="StatusText" Text="Connecting..."
                           Style="{StaticResource BodyTextBlockStyle}" Opacity="0.8"/>
            </StackPanel>

            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"/>

            <StackPanel Spacing="8">
                <TextBlock Text="Firewall mode" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <RadioButtons x:Name="ModeRadios" IsEnabled="False"
                              SelectionChanged="ModeRadios_SelectionChanged"/>
                <TextBlock x:Name="LockNote" Visibility="Collapsed"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="The configuration is locked. Unlock it before changing the mode."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"/>
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20"
                              VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
