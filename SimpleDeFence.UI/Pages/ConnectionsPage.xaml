<Page
    x:Class="SimpleDeFence.UI.Pages.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleDeFence.UI.Pages"
    xmlns:loc="using:SimpleDeFence.UI.Localization">
    <Page.Resources>
        <!-- Hover highlight for the three lists.

             The rows had none. The default ListViewItem paints its pointer-over backplate behind
             the content presenter, and every row template here starts with an opaque Border filling
             the whole row - the red/yellow classification fill - so the backplate was painted and
             then covered by it, on every row that had a fill. Nothing about the pointer was visible,
             which on a list where each row carries its own action reads as the list being inert.

             So the wash moves on top of the content instead of behind it, which is the one thing the
             stock template cannot be talked into doing through Setters alone. It is
             SubtleFillColorSecondaryBrush - the same low-alpha brush Fluent uses for hover - so the
             classification fill still reads through it rather than being replaced.

             Selection states are deliberately absent: all three lists are SelectionMode="None" and
             there is nothing to select. Padding is zeroed because the row templates bring their own
             (12,8). -->
        <Style x:Key="ConnectionRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <!-- Background="Transparent" is load-bearing, not decoration. A Panel with a
                             null Background takes no part in hit testing in WinUI, so pointer events
                             over it fall straight through and the item never enters PointerOver.
                             Every row template paints its classification fill with a Border that is
                             Collapsed when it does not apply, and the Connected and Open rows carry
                             only the local-network one - so on any ordinary internet connection the
                             whole row was blank, unhittable, and the hover this Style exists to add
                             never appeared. It worked on the Blocked list only because those rows
                             carry two complementary Borders and so always paint one.

                             Setting it here rather than on each of the six templates puts the
                             hit-test surface on the container, where it covers the row's full width
                             including the gaps between cells. -->
                        <Grid Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <!-- IsHitTestVisible="False" so the wash never intercepts a click meant
                                 for the Allow or "Show all" button underneath it. -->
                            <Rectangle x:Name="HoverOverlay"
                                       Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                       Opacity="0" IsHitTestVisible="False"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Two templates per list, wide and folded, generated from one definition so they
             cannot drift apart. Below 1000px the page swaps every list to the folded
             pair: the detail, "Show all" and the timestamp drop to a second line under the app
             name instead of being pushed off the right edge, where they were simply clipped -
             not scrollable, just unreachable.

             The swap is driven from the page, not from inside the templates. A VisualState
             with an AdaptiveTrigger placed inside a DataTemplate never activates - state
             groups are only evaluated on a control template root - so the first attempt at
             this simply did nothing. -->
        <DataTemplate x:Key="BlockedRowWide" x:DataType="local:BlockedListItem">
            <Grid ToolTipService.ToolTip="{x:Bind TooltipText}">
                <!-- Row fills. Yellow means every address on this row stayed on the local network;
                     the legend above the lists says so. -->
                <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind RemoteVisibility}"/>
                <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind LocalVisibility}"/>

                <Grid Padding="12,8" ColumnSpacing="12" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*" MinWidth="120" MaxWidth="260"/>
                        <ColumnDefinition Width="Auto" MinWidth="42"/>
                        <ColumnDefinition Width="*" MinWidth="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Row="0" Grid.Column="0" FontSize="14" Glyph="&#xE733;"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind AppName}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind Protocol}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" Opacity="0.8" TextWrapping="NoWrap"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind Detail}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                    <Button Grid.Row="0" Grid.Column="4" Content="{loc:Loc Key=connections.showAll}"
                            Visibility="{x:Bind ShowAllVisibility}" VerticalAlignment="Center">
                        <Button.Flyout>
                            <Flyout Opening="Flyout_Opening">
                                <StackPanel Spacing="8" MinWidth="300" MaxWidth="440">
                                    <TextBlock Text="{x:Bind AppName}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{loc:Loc Key=connections.blocked.attemptsHeader}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{x:Bind Attempts}">
