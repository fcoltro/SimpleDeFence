                                                <DataTemplate x:DataType="local:BlockedAttempt">
                                                    <Grid ColumnSpacing="12" Padding="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind When}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Opacity="0.6" TextWrapping="NoWrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="{x:Bind TruncationNote}" Visibility="{x:Bind TruncationVisibility}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <TextBlock Grid.Row="0" Grid.Column="5" Text="{x:Bind When}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" Opacity="0.6" TextWrapping="NoWrap"/>
                    <!-- Allow stays on the first line even when the row folds: it is the action,
                         and burying it under the detail would be the wrong thing to demote. -->
                    <Button Grid.Row="0" Grid.Column="6" Content="{loc:Loc Key=connections.allow}"
                            VerticalAlignment="Center" Click="{x:Bind AllowButton_Click}"/>
                </Grid>
            </Grid>
        </DataTemplate>

