<Page
    x:Class="SimpleDeFence.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleDeFence.UI.Pages"
    xmlns:loc="using:SimpleDeFence.UI.Localization"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Key=settings.title}" Style="{StaticResource TitleTextBlockStyle}"/>

        <InfoBar Grid.Row="1" x:Name="Notice" IsOpen="False" IsClosable="True"/>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="{loc:Loc Key=common.refresh}" Click="RefreshButton_Click"/>
            <ProgressRing Grid.Column="2" x:Name="Busy" IsActive="False" Width="20" Height="20" VerticalAlignment="Center"/>
        </Grid>

        <!-- HorizontalScrollMode/BarVisibility disabled: a ScrollViewer measures its content with
             infinite width by default, so any card wider than the viewport (the Maintenance and
             Updates rows put two full-width buttons side by side) silently grew the scrollable
             extent instead of being constrained. Scrolling down far enough then let the whole page
             drift sideways and the About section's cards ran off the right edge with their content
             cut off. Disabling the horizontal axis pins the content to the viewport width, which is
             what MaxWidth below was already assuming. -->
        <ScrollViewer x:Name="SettingsScroller" Grid.Row="3"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <!-- Wider than the 720 this used to be pinned to, and centred. Rules and Connections
                 stretch to the window, so a narrow column hard against the left edge made Settings
                 look like a different application on a wide monitor. A cap is still wanted - a
                 settings row stretched across an ultrawide is unreadable - it just belongs in the
                 middle.

                 Getting it to stay in the middle took two goes. Centring the panel directly makes
                 it size to its content, and the sections realize their rows lazily, so the column
                 narrowed on the way down and widened on the way back. Stretch fixed the width but
                 not the position: something inside measures wider than the viewport, the extent
                 grows past it despite HorizontalScrollMode="Disabled", and a centred child centres
                 in the extent rather than in what you can see - so it sat ~90px right of centre and
                 slid as the extent changed.

                 Pinning this Grid to ViewportWidth takes the extent out of it. The panel then
                 centres inside something whose width is exactly the visible area, and Stretch keeps
                 it min(viewport, MaxWidth) no matter which cards happen to be realized. -->
            <Grid Width="{x:Bind SettingsScroller.ViewportWidth, Mode=OneWay}">
                <StackPanel Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch">

                <controls:SettingsExpander Header="{loc:Loc Key=settings.section.general}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE713;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.general.theme}"
                                                Description="{loc:Loc Key=settings.general.themeDescription}">
                            <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged" MinWidth="160">
                                <ComboBoxItem Content="{loc:Loc Key=settings.general.themeAuto}" Tag="auto"/>
                                <ComboBoxItem Content="{loc:Loc Key=settings.general.themeLight}" Tag="light"/>
                                <ComboBoxItem Content="{loc:Loc Key=settings.general.themeDark}" Tag="dark"/>
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.general.language}"
                                                Description="{loc:Loc Key=settings.general.languageDescription}">
                            <!-- Deliberately empty: the items are built in SeedControls from the
                                 language files that actually ship, so this list cannot drift from
                                 them. -->
                            <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged" MinWidth="160"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.general.askForExceptionDetails}"
                                                Description="{loc:Loc Key=settings.general.askForExceptionDetailsDescription}">
                            <ToggleSwitch x:Name="AskForExceptionDetailsToggle" Toggled="AskForExceptionDetailsToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.general.autoRefreshInterval}"
                                                Description="{loc:Loc Key=settings.general.autoRefreshIntervalDescription}">
                            <NumberBox x:Name="AutoRefreshIntervalBox" Minimum="1" Maximum="300"
                                       SmallChange="1" LargeChange="5" MinWidth="120"
                                       SpinButtonPlacementMode="Compact"
                                       ValueChanged="AutoRefreshIntervalBox_ValueChanged"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{loc:Loc Key=settings.general.enableHotkeys}"
                                                Description="{loc:Loc Key=settings.general.enableHotkeysDescription}">
                            <ToggleSwitch x:Name="EnableHotkeysToggle" Toggled="EnableHotkeysToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="{loc:Loc Key=settings.section.protection}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEA18;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.protection.allowLocalSubnet}"
                                                Description="{loc:Loc Key=settings.protection.allowLocalSubnetDescription}">
                            <ToggleSwitch x:Name="AllowLocalSubnetToggle" Toggled="AllowLocalSubnetToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.protection.displayOffBlock}"
                                                Description="{loc:Loc Key=settings.protection.displayOffBlockDescription}">
                            <ToggleSwitch x:Name="DisplayOffBlockToggle" Toggled="DisplayOffBlockToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="{loc:Loc Key=settings.section.blocklists}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE71C;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.blocklists.enable}"
                                                Description="{loc:Loc Key=settings.blocklists.enableDescription}">
                            <ToggleSwitch x:Name="EnableBlocklistsToggle" Toggled="EnableBlocklistsToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.blocklists.hosts}">
                            <ToggleSwitch x:Name="EnableHostsBlocklistToggle" Toggled="EnableHostsBlocklistToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.blocklists.ports}">
                            <ToggleSwitch x:Name="EnablePortBlocklistToggle" Toggled="EnablePortBlocklistToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="{loc:Loc Key=settings.section.security}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.security.lockHostsFile}"
                                                Description="{loc:Loc Key=settings.security.lockHostsFileDescription}">
                            <ToggleSwitch x:Name="LockHostsFileToggle" Toggled="LockHostsFileToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>

                        <!-- The form goes in the card's Header slot, not its Content slot, and not
                             via ContentAlignment="Vertical" either. A SettingsCard puts Content in
                             the narrow right-hand column beside the header - right for one switch
                             or one combo box, wrong for a form, and it left the password boxes
                             jammed against the card's right edge with the status line floating over
                             them, which is what looked misplaced. ContentAlignment="Vertical" is
                             the documented way to get a full-width row instead, but it has no
                             effect on a card sitting inside SettingsExpander.Items - the expander
                             restyles its child cards and the setting is lost (verified live: the
                             form stayed right-aligned). Header is laid out left-aligned across the
                             card's main column regardless, so the form is placed there and carries
                             its own heading. -->
                        <controls:SettingsCard IsClickEnabled="False">
                            <controls:SettingsCard.Header>
                                <StackPanel Spacing="8" HorizontalAlignment="Left" MinWidth="300" Margin="0,4">
                                    <TextBlock Text="{loc:Loc Key=settings.security.setPassword}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="PasswordStatusText" Opacity="0.8"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <!-- What "no password is set" actually means, shown only while
                                         it is true. The service authenticates the program that
                                         connects to it, not the person running it, so the password
                                         is the only thing that distinguishes the owner of the PC
                                         from anyone else who can sign in to it. -->
                                    <TextBlock x:Name="PasswordNotSetDetailText"
                                               Text="{loc:Loc Key=settings.security.passwordNotSetDetail}"
                                               Opacity="0.8" TextWrapping="Wrap" MaxWidth="360"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <PasswordBox x:Name="NewPasswordBox" PlaceholderText="{loc:Loc Key=settings.security.newPassword}" HorizontalAlignment="Stretch"/>
                                    <PasswordBox x:Name="NewPasswordConfirmBox" PlaceholderText="{loc:Loc Key=settings.security.confirmPassword}" HorizontalAlignment="Stretch"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SetPasswordButton" Content="{loc:Loc Key=settings.security.setPassword}" Click="SetPasswordButton_Click"/>
                                        <Button x:Name="RemovePasswordButton" Content="{loc:Loc Key=settings.security.removePassword}" Click="RemovePasswordButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>

                        <controls:SettingsCard IsClickEnabled="False">
                            <controls:SettingsCard.Header>
                                <StackPanel Spacing="8" HorizontalAlignment="Left" MinWidth="300" Margin="0,4">
                                    <TextBlock Text="{loc:Loc Key=settings.security.lockNow}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="LockStatusText" Opacity="0.8"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <Button x:Name="LockNowButton" Content="{loc:Loc Key=settings.security.lockNow}"
                                            HorizontalAlignment="Left" Click="LockNowButton_Click"/>
                                    <StackPanel x:Name="UnlockPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                        <PasswordBox x:Name="UnlockPasswordBox" PlaceholderText="{loc:Loc Key=settings.security.unlockPasswordPlaceholder}" MinWidth="200"/>
                                        <Button x:Name="UnlockButton" Content="{loc:Loc Key=settings.security.unlock}" Click="UnlockButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="{loc:Loc Key=settings.section.updates}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE895;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.updates.autoCheck}"
                                                Description="{loc:Loc Key=settings.updates.autoCheckDescription}">
                            <ToggleSwitch x:Name="AutoUpdateCheckToggle" Toggled="AutoUpdateCheckToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard IsClickEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckForUpdatesNowButton" Content="{loc:Loc Key=settings.updates.checkNow}" Click="CheckForUpdatesNow_Click"/>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="{loc:Loc Key=settings.section.logging}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.logging.enabled}"
                                                Description="{loc:Loc Key=settings.logging.enabledDescription}">
                            <ToggleSwitch x:Name="ConnectionLogToggle" Toggled="ConnectionLogToggle_Toggled"
                                          OnContent="{loc:Loc Key=common.on}"
                                          OffContent="{loc:Loc Key=common.off}"/>
                        </controls:SettingsCard>

                        <!-- A plain text box, not a file picker. The WinRT FileSavePicker is the
                             obvious control here, but the pickers on this page's sibling screen have
                             a documented history of failing outright in unpackaged builds on some
                             machines (RulesPage's executable/folder pickers), and a log path the
                             user cannot type in when the picker fails is a dead end. The path is
                             validated on commit instead, and left empty means the default. -->
                        <controls:SettingsCard Header="{loc:Loc Key=settings.logging.path}"
                                                Description="{loc:Loc Key=settings.logging.pathDescription}">
                            <!-- A Grid, not a horizontal StackPanel, and no MinWidth on the box.
                                 A StackPanel hands each child its full desired width and the box
                                 asked for 260, so this content could not shrink below roughly 400px.
                                 SettingsCard gives its content what it asks for and leaves the rest
                                 to the header, so on a narrow window the header column collapsed and
                                 the description wrapped one character per line. Here the box takes
                                 the star column and gives way instead. -->
                            <Grid ColumnSpacing="8" MinWidth="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ConnectionLogPathBox" MaxWidth="320"
                                         HorizontalAlignment="Stretch"
                                         PlaceholderText="{loc:Loc Key=settings.logging.pathPlaceholder}"
                                         LostFocus="ConnectionLogPathBox_LostFocus"/>
                                <Button Grid.Column="1" x:Name="OpenLogFolderButton" Content="{loc:Loc Key=settings.logging.openFolder}"
                                        Click="OpenLogFolderButton_Click"/>
                            </Grid>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{loc:Loc Key=settings.logging.interval}"
                                                Description="{loc:Loc Key=settings.logging.intervalDescription}">
                            <NumberBox x:Name="ConnectionLogIntervalBox" Minimum="1" Maximum="3600"
                                       SmallChange="1" LargeChange="10" MinWidth="120"
                                       SpinButtonPlacementMode="Compact"
                                       ValueChanged="ConnectionLogIntervalBox_ValueChanged"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{loc:Loc Key=settings.logging.maxSize}"
                                                Description="{loc:Loc Key=settings.logging.maxSizeDescription}">
                            <NumberBox x:Name="ConnectionLogMaxSizeBox" Minimum="1" Maximum="1024"
                                       SmallChange="1" LargeChange="5" MinWidth="120"
                                       SpinButtonPlacementMode="Compact"
                                       ValueChanged="ConnectionLogMaxSizeBox_ValueChanged"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="{loc:Loc Key=settings.section.maintenance}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEC7A;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard IsClickEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ImportButton" Content="{loc:Loc Key=settings.maintenance.import}" Click="ImportButton_Click"/>
                                <Button x:Name="ExportButton" Content="{loc:Loc Key=settings.maintenance.export}" Click="ExportButton_Click"/>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="{loc:Loc Key=settings.section.about}" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <!-- Header and Description are set in code so the version is the real one.
                             This card used to read Assembly.GetExecutingAssembly() from inside
                             SimpleDeFence.UI, whose own <Version> is 1.0.0 - so About cheerfully
                             reported 1.0.0 for a 0.1.0 build. -->
                        <controls:SettingsCard x:Name="AboutVersionCard" IsClickEnabled="False"/>

                        <controls:SettingsCard Header="{loc:Loc Key=settings.about.basedOn}"
                                               Description="{loc:Loc Key=settings.about.basedOnDetail}"
                                               IsClickEnabled="True" Click="AboutUpstream_Click"/>

                        <!-- These two open in the app rather than handing a file to the shell. The
                             previous versions launched License.rtf and Attributions.txt from the
                             application directory; neither has shipped since the MSI stopped being
                             built from a hand-copied file tree, so both merely raised an error. The
                             text is embedded now and cannot go missing. -->
                        <controls:SettingsCard Header="{loc:Loc Key=settings.about.license}"
                                               Description="{loc:Loc Key=settings.about.licenseDetail}"
                                               IsClickEnabled="True" Click="AboutLicense_Click"/>
                        <controls:SettingsCard Header="{loc:Loc Key=settings.about.attributions}"
                                               Description="{loc:Loc Key=settings.about.attributionsDetail}"
                                               IsClickEnabled="True" Click="AboutAttributions_Click"/>

                        <!-- A webpage genuinely belongs in a browser, so this one still leaves. -->
                        <controls:SettingsCard Header="{loc:Loc Key=settings.about.homepage}"
                                               Description="{loc:Loc Key=settings.about.homepageDetail}"
                                               IsClickEnabled="True" Click="AboutHomepage_Click"/>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
