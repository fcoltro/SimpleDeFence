<Project>

  <PropertyGroup>
    <!-- Every project here targets net10.0-windows10.0.19041.0, and restoring a Windows-targeting
         project on a non-Windows host fails with NETSDK1100 unless this is set. That is not a
         hypothetical: GitHub's automatic dependency submission runs on Linux runners, so it failed
         on every single commit until this was added, and the dependency graph for this repository
         was never actually populated.

         Restore-only, and safe: it permits the Windows targeting packs to be resolved as NuGet
         packages instead of from a local Windows SDK install. It does not make the projects
         buildable or runnable off Windows - compiling still needs a Windows host - and it changes
         nothing about what a Windows build produces. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
