<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <RootNamespace>SimpleDeFence</RootNamespace>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <PropertyGroup>
    <Product>SimpleDeFence.Core</Product>
    <AssemblyTitle>SimpleDeFence.Core</AssemblyTitle>
    <Company>fcoltro</Company>
    <Description>Protocol, IPC, and shared config/rule model for SimpleDeFence - used by both the WinForms and WinUI 3 GUIs to talk to the service.</Description>
    <Copyright>Copyright © 2011 Károly Pados, Copyright © 2026 fcoltro</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <PackageReference Include="Nullable" Version="1.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Memory" Version="4.5.4" />
    <!-- Used for WinRT access (UwpPackageList) in .Net 4.8, not needed with .NET 5+ -->
    <Reference Include="Windows.Management" />
    <Reference Include="Windows.ApplicationModel" />
    <Reference Include="System.Runtime" />
    <!-- UpdateDescriptorFetcher.cs uses HttpClient; on net10 it resolves implicitly, but net48 SDK
         projects don't implicitly reference System.Net.Http the way they do System/System.Core. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net48'">
    <TargetPlatformVersion>8.0</TargetPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="6.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- One file per language holds every string in the app. Embedded rather than shipped loose so
         a translation cannot go missing at runtime. WithCulture="false" is required: MSBuild's
         culture-detection heuristic (the same one that builds Foo.en.resx into a satellite
         resources.dll) matches "Strings.en.json" too, silently rerouting it into a satellite
         assembly under a different logical name than the one below - Loc.Load then finds nothing
         and every locale silently falls back to English. LogicalName pins the exact name Loc.cs
         looks up: SimpleDeFence.Localization.Strings.<culture>.json -->
    <EmbeddedResource Include="Localization\Strings.*.json" WithCulture="false"
                       LogicalName="SimpleDeFence.Localization.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets LocTests read Loc.Load(culture) directly, to check key parity per-locale without
         mutating the shared static culture that Loc.SetCulture affects process-wide. -->
    <InternalsVisibleTo Include="SimpleDeFence.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SimpleDeFence.Windows\SimpleDeFence.Windows.csproj" />
  </ItemGroup>
</Project>
