*.exe
*.dll
*.msi
*.zip
*.suo

/.vs/
/.tx/
/.worktrees/
/.superpowers/

# Plans and design specs the SDD workflow writes here. The folder was deleted; this
# keeps a future run from committing a new one. Git history already records how each
# change was arrived at.
/docs/

# Local agent/tool state. Each of these currently carries its own self-ignoring
# .gitignore; naming them here means deleting that file cannot leak them into a commit.
/.claude/
/.code-review-graph/
/.remember/


/SimpleDeFence.suo
/SimpleDeFence.v11.suo

/SimpleDeFence/obj/
/SimpleDeFence/bin/

/SimpleDeFence.Core/obj/
/SimpleDeFence.Core/bin/

/SimpleDeFence.Tests/obj/
/SimpleDeFence.Tests/bin/

/SimpleDeFence.UI/obj/
/SimpleDeFence.UI/bin/

/SimpleDeFence.Utilities/obj/
/SimpleDeFence.Utilities/bin/

/SimpleDeFence.Windows/obj/
/SimpleDeFence.Windows/bin/

/SimpleDeFence.Windows.Services/obj/
/SimpleDeFence.Windows.Services/bin/

/SimpleDeFence.Windows.WFP/bin/
/SimpleDeFence.Windows.WFP/obj/

/MsiSetup/obj/
/MsiSetup/bin/
/MsiSetup/Sources/ProgramFiles/

# Self-contained publish output (~270 MB); produced by
# dotnet publish SimpleDeFence/SimpleDeFence.csproj -c Release -r win-x64 --self-contained true -o publish-out
/publish-out/

# Per-developer Visual Studio state; not shared.
*.user

# Generated by the heat.exe harvest documented in MsiSetup/HarvestPublishDir.xslt.
# Not checked in: it is derived entirely from the publish output and would go
# stale against it. (The harvest uses -ag, so component GUIDs are stable across
# builds - it is the file list that moves, not the identities.)
MsiSetup/Dependencies.wxs

# Test run output; regenerated by every dotnet test.
/SimpleDeFence.Tests/TestResults/
